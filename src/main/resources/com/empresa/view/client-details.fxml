<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.empresa.controller.ClientDetailsController" styleClass="app-shell">
    <left>
        <VBox spacing="28" styleClass="sidebar">
            <padding><Insets top="28" right="18" bottom="22" left="18"/></padding>
            <HBox spacing="11" alignment="CENTER_LEFT">
                <Label text="G" styleClass="brand-icon"/>
                <VBox spacing="3">
                    <Label text="UCACUE Gym" styleClass="brand-name"/>
                    <Label text="GESTIÓN DE CLIENTES" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <VBox spacing="10">
                <Label text="ESPACIO DE TRABAJO" styleClass="menu-title"/>
                <Button text="◎   Clientes" maxWidth="Infinity" onAction="#onBack" styleClass="nav-button"/>
            </VBox>
            <VBox VBox.vgrow="ALWAYS"/>
            <Label text="Módulo de clientes&#10;Gestión de socios" styleClass="sidebar-footer"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="screen-scroll">
            <content>
                <VBox spacing="20" alignment="TOP_CENTER" styleClass="content-area">
                    <padding><Insets top="26" right="32" bottom="30" left="32"/></padding>
                    <HBox maxWidth="860" alignment="CENTER_LEFT">
                        <Button text="←  Volver al directorio" onAction="#onBack" styleClass="text-button"/>
                    </HBox>
                    <VBox maxWidth="860" spacing="6">
                        <Label text="GESTIÓN DE CLIENTES" styleClass="eyebrow"/>
                        <Label text="Detalle del cliente" styleClass="page-heading"/>
                        <Label text="Datos personales y ficha técnica del gimnasio." styleClass="page-description"/>
                    </VBox>
                    <VBox maxWidth="860" spacing="20" styleClass="form-card">
                        <padding><Insets top="26" right="28" bottom="26" left="28"/></padding>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <Label text="G" styleClass="detail-avatar"/>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label fx:id="nameLabel" text="Nombre del cliente" maxWidth="Infinity" wrapText="true" styleClass="detail-name"/>
                                <Label fx:id="idLabel" text="GYM-0000" styleClass="detail-code"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="14" styleClass="detail-section">
                            <Label text="DATOS DE PERSONA" styleClass="menu-title"/>
                            <HBox spacing="12" styleClass="detail-row">
                                <Label text="Cédula" styleClass="detail-key"/>
                                <Label fx:id="identificationNumberLabel" text="Cédula" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" styleClass="detail-value"/>
                            </HBox>
                            <HBox spacing="12" styleClass="detail-row">
                                <Label text="Nombres" styleClass="detail-key"/>
                                <Label fx:id="firstNameLabel" text="Nombres" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" styleClass="detail-value"/>
                            </HBox>
                            <HBox spacing="12" styleClass="detail-row">
                                <Label text="Apellidos" styleClass="detail-key"/>
                                <Label fx:id="lastNameLabel" text="Apellidos" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" styleClass="detail-value"/>
                            </HBox>
                            <HBox spacing="12" styleClass="detail-row">
                                <Label text="Teléfono" styleClass="detail-key"/>
                                <Label fx:id="phoneLabel" text="Teléfono" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" styleClass="detail-value"/>
                            </HBox>
                            <HBox spacing="12" styleClass="detail-row">
                                <Label text="Correo electrónico" styleClass="detail-key"/>
                                <Label fx:id="emailLabel" text="correo@ejemplo.com" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" styleClass="detail-value"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="14" styleClass="detail-section">
                            <Label text="FICHA TÉCNICA DE GIMNASIO" styleClass="menu-title"/>
                            <HBox spacing="12" styleClass="detail-row">
                                <Label text="Talla" styleClass="detail-key"/>
                                <Label fx:id="heightLabel" text="1.75 m" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" styleClass="detail-value"/>
                            </HBox>
                            <HBox spacing="12" styleClass="detail-row">
                                <Label text="Sexo" styleClass="detail-key"/>
                                <Label fx:id="sexLabel" text="MASCULINO" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" styleClass="detail-value"/>
                            </HBox>
                        </VBox>
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="Eliminar cliente" onAction="#onDelete" styleClass="danger-button"/>
                            <Button text="Editar información" onAction="#onEdit" styleClass="primary-button"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
