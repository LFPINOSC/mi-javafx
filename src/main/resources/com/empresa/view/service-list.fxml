<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.empresa.controller.ServiceListController" styleClass="app-shell">
    <left>
        <VBox spacing="28" styleClass="sidebar">
            <padding><Insets top="28" right="18" bottom="22" left="18"/></padding>
            <HBox spacing="11" alignment="CENTER_LEFT"><Label text="G" styleClass="brand-icon"/><VBox spacing="3"><Label text="UCACUE Gym" styleClass="brand-name"/><Label text="GESTIÓN DE SERVICIOS" styleClass="brand-subtitle"/></VBox></HBox>
            <VBox spacing="10">
                <Label text="ESPACIO DE TRABAJO" styleClass="menu-title"/>
                <Button text="⌂   Dashboard" maxWidth="Infinity" onAction="#onDashboard" styleClass="nav-button"/>
                <Button text="◉   Clientes" maxWidth="Infinity" onAction="#onClients" styleClass="nav-button"/>
                <Button text="▦   Servicios" maxWidth="Infinity" styleClass="nav-button-selected"/>
                <Button text="▣   Membresías" maxWidth="Infinity" onAction="#onMemberships" styleClass="nav-button"/>
            </VBox>
            <VBox VBox.vgrow="ALWAYS"/>
            <Label text="Catálogo de servicios&#10;Administración del gimnasio" styleClass="sidebar-footer"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="20" styleClass="content-area">
            <padding><Insets top="28" right="30" bottom="28" left="30"/></padding>
            <HBox alignment="CENTER_RIGHT"><Label text="CATÁLOGO DE SERVICIOS" styleClass="user-label"/></HBox>
            <VBox spacing="6">
                <Label text="GESTIÓN DEL GIMNASIO" styleClass="eyebrow"/>
                <Label text="Catálogo de servicios" styleClass="page-heading"/>
                <Label text="Registra y administra los servicios que ofrece el gimnasio." styleClass="page-description"/>
            </VBox>
            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox spacing="14" styleClass="table-card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Servicios registrados" styleClass="section-heading"/><Label fx:id="resultCountLabel" text="0 servicios" styleClass="metric-detail"/></VBox>
                    </HBox>
                    <TextField fx:id="searchField" promptText="Buscar por código o nombre..." styleClass="search-field"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Mostrar:" styleClass="form-label"/>
                        <ComboBox fx:id="statusFilterBox" prefWidth="150"/>
                        <Button text="+ Nuevo servicio" onAction="#onNewService" styleClass="primary-button" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <TableView fx:id="servicesTable" VBox.vgrow="ALWAYS" styleClass="clients-table">
                        <columns>
                            <TableColumn fx:id="codeColumn" text="CÓDIGO" prefWidth="130"/>
                            <TableColumn fx:id="nameColumn" text="NOMBRE DEL SERVICIO" prefWidth="250"/>
                            <TableColumn fx:id="statusColumn" text="ESTADO" prefWidth="110"/>
                        </columns>
                    </TableView>
                    <HBox spacing="9" alignment="CENTER_RIGHT">
                        <Button text="Editar seleccionado" onAction="#onEditService" styleClass="secondary-button"/>
                        <Button text="Eliminar" onAction="#onDeleteService" styleClass="danger-button"/>
                    </HBox>
                </VBox>
                <VBox spacing="15" prefWidth="300" styleClass="form-card">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <VBox spacing="5"><Label fx:id="formTitleLabel" text="Nuevo servicio" styleClass="section-heading"/><Label text="Completa los datos del catálogo." styleClass="metric-detail"/></VBox>
                    <VBox spacing="7"><Label text="Código" styleClass="form-label"/><TextField fx:id="codeField" promptText="Ej. SRV-001" styleClass="form-input"/></VBox>
                    <VBox spacing="7"><Label text="Nombre del servicio" styleClass="form-label"/><TextField fx:id="nameField" promptText="Ej. Musculación" styleClass="form-input"/></VBox>
                    <VBox spacing="7"><Label text="Estado" styleClass="form-label"/><ComboBox fx:id="statusBox" maxWidth="Infinity"/></VBox>
                    <Label fx:id="validationLabel" styleClass="validation-message" wrapText="true"/>
                    <VBox VBox.vgrow="ALWAYS"/>
                    <Button fx:id="saveButton" text="Guardar servicio" onAction="#onSaveService" styleClass="primary-button" maxWidth="Infinity"/>
                    <Button text="Limpiar formulario" onAction="#onClearForm" styleClass="secondary-button" maxWidth="Infinity"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
