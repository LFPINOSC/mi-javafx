<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.empresa.controller.ClientListController" styleClass="app-shell">
    <left>
        <VBox spacing="28" styleClass="sidebar">
            <padding><Insets top="28" right="18" bottom="22" left="18"/></padding>
            <HBox spacing="11" alignment="CENTER_LEFT">
                <Label text="G" styleClass="brand-icon"/>
                <VBox spacing="3">
                    <Label text="UCACUE Gym" styleClass="brand-name"/>
                    <Label text="GESTIÓN DE CLIENTES" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <VBox spacing="10">
                <Label text="ESPACIO DE TRABAJO" styleClass="menu-title"/>
                <Button text="◎   Clientes" maxWidth="Infinity" styleClass="nav-button-selected"/>
            </VBox>
            <VBox VBox.vgrow="ALWAYS"/>
            <Label text="Módulo de clientes&#10;Gestión de socios" styleClass="sidebar-footer"/>
        </VBox>
    </left>
    <center>
        <StackPane styleClass="content-area">
            <VBox maxWidth="1200" spacing="22" styleClass="content-area">
                <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>
                <HBox alignment="CENTER_RIGHT">
                    <Label text="DIRECTORIO DE CLIENTES" styleClass="user-label"/>
                </HBox>
                <VBox spacing="6">
                    <Label text="GESTIÓN DE CLIENTES" styleClass="eyebrow"/>
                    <Label text="Clientes" styleClass="page-heading"/>
                    <Label text="Consulta y administra la información de tus clientes." styleClass="page-description"/>
                </VBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Buscar por código, cédula, nombre, correo o teléfono..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                    <Button text="+  Nuevo cliente" onAction="#onNewClient" styleClass="primary-button"/>
                </HBox>
                <VBox spacing="14" styleClass="table-card" VBox.vgrow="ALWAYS">
                    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Directorio de clientes" styleClass="section-heading"/>
                            <Label text="Selecciona un cliente para ver, editar o eliminar su ficha." styleClass="metric-detail"/>
                        </VBox>
                    </HBox>
                    <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS" styleClass="clients-table">
                        <columns>
                            <TableColumn fx:id="idColumn" text="CÓDIGO SOCIO" prefWidth="110"/>
                            <TableColumn fx:id="identificationNumberColumn" text="CÉDULA" prefWidth="110"/>
                            <TableColumn fx:id="firstNameColumn" text="NOMBRES" prefWidth="120"/>
                            <TableColumn fx:id="lastNameColumn" text="APELLIDOS" prefWidth="130"/>
                            <TableColumn fx:id="emailColumn" text="CORREO ELECTRÓNICO" prefWidth="205"/>
                            <TableColumn fx:id="phoneColumn" text="TELÉFONO" prefWidth="115"/>
                            <TableColumn fx:id="heightColumn" text="TALLA" prefWidth="75"/>
                            <TableColumn fx:id="sexColumn" text="SEXO" prefWidth="95"/>
                        </columns>
                    </TableView>
                    <HBox spacing="9" alignment="CENTER_RIGHT">
                        <Button text="Ver detalle" onAction="#onViewDetails" styleClass="secondary-button"/>
                        <Button text="Editar" onAction="#onEditClient" styleClass="secondary-button"/>
                        <Button text="Eliminar" onAction="#onDeleteClient" styleClass="danger-button"/>
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
